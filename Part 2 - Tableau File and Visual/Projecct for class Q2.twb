      <column caption='% Out of Compliance Rate' datatype='real' default-format='p0%' name='[Calculation_1513268196610049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Pivot Field Values] = &apos;Out of Compliance&apos; THEN 1 END) &#13;&#10;/ &#13;&#10;COUNT(IF [Pivot Field Values] = &apos;In Compliance&apos; OR [Pivot Field Values] = &apos;Out of Compliance&apos; THEN 1 END)' />
      </column>
      <column caption='Season' datatype='string' name='[Calculation_1513268199337987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE MONTH([Inspection Date])&#13;&#10;    WHEN 12 THEN &apos;Winter&apos;&#13;&#10;    WHEN 1 THEN &apos;Winter&apos;&#13;&#10;    WHEN 2 THEN &apos;Winter&apos;&#13;&#10;    WHEN 3 THEN &apos;Spring&apos;&#13;&#10;    WHEN 4 THEN &apos;Spring&apos;&#13;&#10;    WHEN 5 THEN &apos;Spring&apos;&#13;&#10;    WHEN 6 THEN &apos;Summer&apos;&#13;&#10;    WHEN 7 THEN &apos;Summer&apos;&#13;&#10;    WHEN 8 THEN &apos;Summer&apos;&#13;&#10;    WHEN 9 THEN &apos;Fall&apos;&#13;&#10;    WHEN 10 THEN &apos;Fall&apos;&#13;&#10;    WHEN 11 THEN &apos;Fall&apos;&#13;&#10;END' />
